# scripts/demo/run.sh --target uat — the demo against a DEPLOYED CryptoBot (KAN-574 UAT), no docker.
# Copy to .env.demo-uat (gitignored) and fill in. Never commit the copy; never paste the values in a chat.
#
# The service, as reached from where run.sh runs. UAT has no public DNS on purpose: from the host,
# add --resolve with the IP of le-uat-nginx (docker inspect) in CRYPTOBOT_DEMO_CURL_OPTS.
CRYPTOBOT_DEMO_BASE_URL=https://cryptobot-uat.life-engine.app
CRYPTOBOT_DEMO_CURL_OPTS=
# e.g. CRYPTOBOT_DEMO_CURL_OPTS=--resolve cryptobot-uat.life-engine.app:443:172.31.0.10 -k

# The bearer: either a JWT already issued by Life Engine Auth (RUNTIME_OPERATOR + RUNTIME_ADMIN for the
# anchor sweep) …
CRYPTOBOT_DEMO_TOKEN=
# … or the Auth login the script performs (credentials go on stdin, the token stays in memory).
CRYPTOBOT_DEMO_AUTH_URL=https://auth-uat.life-engine.app/api/auth/login
CRYPTOBOT_DEMO_AUTH_USER=
CRYPTOBOT_DEMO_AUTH_PASSWORD=

# The wallet the UAT signer controls (public key: GET /api/signer/identity from inside the UAT network,
# or the value uat/scripts/cryptobot-devnet-credentials.sh printed) and the destination vault
# (CRYPTOBOT_REBALANCE_VAULT of the UAT service). Public keys only.
DEMO_WALLET_ADDRESS=
CRYPTOBOT_REBALANCE_VAULT=

# Devnet RPC the script asks directly for signatures and vault transfers (the chain, not the service).
CRYPTOBOT_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
