SPRING_PROFILES_ACTIVE=local
CRYPTOBOT_SERVICE_PORT=8091
CRYPTOBOT_RUNTIME_BASE_URL=http://localhost:8090
CRYPTOBOT_SNAPSHOT_PROVIDER=deterministic-local
CRYPTOBOT_SECURITY_ENABLED=true

# Local Postgres credentials. We reuse the existing `life` role on the
# life-engine-postgres container; the dedicated `life_engine_cryptobot`
# database is provisioned by scripts/dev-db-setup.sh (auto-invoked by
# scripts/dev-up.sh). Use CRYPTOBOT_* variables only — do NOT set
# SPRING_R2DBC_URL / SPRING_FLYWAY_URL here, those bind to the same
# Spring properties as application.yml's CRYPTOBOT_* placeholders and
# can leak across services if exported by mistake.
CRYPTOBOT_DB_USER=life
CRYPTOBOT_DB_PASSWORD=life
CRYPTOBOT_R2DBC_URL=r2dbc:postgresql://localhost:5433/life_engine_cryptobot
CRYPTOBOT_JDBC_URL=jdbc:postgresql://localhost:5433/life_engine_cryptobot

JWT_SECRET=local-dev-jwt-hs512-secret-minimum-32-chars-long-xx
