    {
      "type": "stat",
      "title": "% sin resultado",
      "description": "Búsquedas sin resultado ÷ búsquedas totales en el rango.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(cryptobot_glossary_search_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\", hit=\"false\"}[$__range])) / clamp_min(sum(increase(cryptobot_glossary_search_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\"}[$__range])), 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
