    {
      "type": "stat",
      "title": "Búsquedas sin resultado",
      "description": "hit=\"false\": lo que la gente busca y el glosario no tiene. > 0 es una tarea de contenido, no una alerta.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(cryptobot_glossary_search_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\", hit=\"false\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
