    {
      "type": "stat",
      "title": "Términos distintos con serie",
      "description": "Series distintas por `term` en el servicio. El tope es 1200 (CryptobotMetrics.MAX_GLOSSARY_TERMS); pasado ese tope todo término nuevo cae en `other`. 864 en el glosario hoy.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "count(sum by (term) (cryptobot_glossary_term_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 1200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
