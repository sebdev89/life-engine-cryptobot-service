{
  "uid": "le-cryptobot-glosario",
  "title": "Life Engine — CryptoBot (glosario: uso medible)",
  "description": "an internal ticket. Eventos open/search/copy del glosario (864 términos) que cryptobot-ui manda en batch a POST /api/cryptobot/glossary/events; cryptobot-service los vuelve cryptobot_glossary_term_total{term,action} y cryptobot_glossary_search_total{hit}. La UI nunca habla con Prometheus/Grafana; Runtime no participa.",
  "tags": [
    "life-engine",
    "cryptobot",
    "glosario",
    "producto"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "label": "Ambiente",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(up, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "uat",
          "value": "uat"
        },
        "description": "Por defecto uat (donde CryptoBot tiene scrape desde un cambio anterior). El mismo tablero sirve para prod y local."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "CryptoBot — negocio y trade funnel",
      "type": "dashboards",
      "tags": [
        "funnel"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "GLOSARIO  ·  qué abren, qué buscan, qué no encuentran  (eventos de cryptobot-ui → cryptobot-service → Prometheus)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Interacciones",
      "description": "cryptobot_glossary_term_total: cada término abierto, buscado (con resultado) o copiado en el rango. Sin identidad: se mide el término, no la persona.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(cryptobot_glossary_term_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Términos abiertos",
      "description": "action=\"open\": alguien desplegó la definición de un término.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(cryptobot_glossary_term_total{environment=\"$environment\", service=~\"cryptobot|cryptobot-service\", action=\"open\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
