# cryptobot-service — copy to .env.local; do not commit live values.
# Same JWT_SECRET must be set in life-engine-auth and life-engine-runtime.

SPRING_PROFILES_ACTIVE=local
CRYPTOBOT_SERVICE_PORT=8091
CRYPTOBOT_RUNTIME_BASE_URL=http://localhost:8090
CRYPTOBOT_SNAPSHOT_PROVIDER=deterministic-local
CRYPTOBOT_SECURITY_ENABLED=true

# Service-to-service credential towards Runtime (KAN-69). Optional in local with the default
# auth-mode=passthrough and the monitoring loop off. Required (a real environment refuses to start
# without it) when CRYPTOBOT_RUNTIME_AUTH_MODE=service or CRYPTOBOT_MONITORING_ENABLED=true. The
# secret is the one Auth holds for client `cryptobot`; never commit it.
CRYPTOBOT_RUNTIME_AUTH_MODE=passthrough
AUTH_INTERNAL_BASE_URL=http://localhost:8081
CRYPTOBOT_S2S_CLIENT_ID=cryptobot
CRYPTOBOT_S2S_CLIENT_SECRET=

# Required (KAN-350): there is no default in application*.yml any more. At least 32 bytes,
# e.g. `openssl rand -hex 32`, identical to the one auth and runtime use. Alternatively set
# AUTH_JWKS_URI to verify RS256 tokens without a shared secret.
JWT_SECRET=

# Decision Receipts (KAN-391). Optional in local: unset ⇒ an ephemeral signing key and salt are
# generated at startup and every receipt dies with the process (the log says so at WARN).
# For any environment that anchors: a 64-byte Ed25519 secret (seed ‖ public key, the layout of
# `solana-keygen new`), base64 or hex, from secrets/ — never committed. Rotate by changing KEY_ID.
CRYPTOBOT_RECEIPT_KEY_ID=
CRYPTOBOT_RECEIPT_SIGNING_KEY=
CRYPTOBOT_RECEIPT_SALT_SECRET=

# Independent validator (KAN-438, paper §20). Off in local by default: with it off (or unreachable)
# every proposal is a paper trade (VALIDATOR_AVAILABLE) and execution fails closed. To execute on
# devnet run validator/ (:8097) and signer/ with SIGNER_VALIDATOR_PUBLIC_KEY, then:
CRYPTOBOT_VALIDATOR_ENABLED=false
CRYPTOBOT_VALIDATOR_BASE_URL=http://localhost:8097
CRYPTOBOT_VALIDATOR_TOKEN=
# Timelock after approval (paper §19): ESCALATE verdicts wait this long; ALLOW verdicts do not wait.
CRYPTOBOT_TIMELOCK_ESCALATED=30m
CRYPTOBOT_TIMELOCK_AUTONOMOUS=0s

# Anchoring on Solana devnet (KAN-394). Off by default: the job needs the isolated signer
# (CRYPTOBOT_SIGNER_ENABLED=true) and its devnet key with a little SOL for fees (~5000 lamports per
# batch). POST /api/cryptobot/anchors (RUNTIME_ADMIN) runs a sweep on demand either way.
# The cluster is not configurable on purpose: devnet only.
CRYPTOBOT_ANCHOR_ENABLED=false
CRYPTOBOT_ANCHOR_INTERVAL=60s
CRYPTOBOT_ANCHOR_BATCH_SIZE=256
CRYPTOBOT_ANCHOR_MAX_ATTEMPTS=5
CRYPTOBOT_ANCHOR_FINALITY_WAIT=60s
