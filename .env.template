# cryptobot-service — copy to .env.local; do not commit live values.
# Same JWT_SECRET must be set in life-engine-auth and life-engine-runtime.

SPRING_PROFILES_ACTIVE=local
CRYPTOBOT_SERVICE_PORT=8091
CRYPTOBOT_RUNTIME_BASE_URL=http://localhost:8090
CRYPTOBOT_SNAPSHOT_PROVIDER=deterministic-local
CRYPTOBOT_SECURITY_ENABLED=true

# Required (KAN-350): there is no default in application*.yml any more. At least 32 bytes,
# e.g. `openssl rand -hex 32`, identical to the one auth and runtime use. Alternatively set
# AUTH_JWKS_URI to verify RS256 tokens without a shared secret.
JWT_SECRET=
