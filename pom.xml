<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.lifeengine</groupId>
    <artifactId>cryptobot-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cryptobot-service</name>
    <description>Vertical service for the crypto.market-review.v1 happy path — sim/paper, no live orders.</description>

    <properties>
        <java.version>21</java.version>
        <spring.boot.version>3.4.2</spring.boot.version>
        <!-- pinned to the same line life-engine-auth and life-engine-runtime use. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              the Testcontainers BOM is imported BEFORE Spring Boot's dependencies so its newer
              versions win over Boot 3.4.2's bundled 1.20.4, whose docker-java speaks API 1.32 and is
              refused by Docker Engine 25+ ("client version 1.32 is too old"). Same pin as life-engine-runtime.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
          logs JSON con campos comunes (service, env, version, commitSha, traceId, spanId,
          requestId, correlationId, tenantId, proposalId, operationId, runtimeRunId, errorCode…). Mismo
          patrón que ATP/Dev Agent. 8.0 es la línea para logback 1.5 (Spring Boot 3.4).
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>
        <!-- traceId/spanId en el MDC (y en cada línea JSON). La exportación OTLP se enciende por entorno con
             MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=true + OTEL_EXPORTER_OTLP_ENDPOINT; apagada, el tracer sólo genera ids. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Propagación del Reactor Context al MDC (LogContext + spring.reactor.context-propagation=auto). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- R2DBC + Postgres for observability persistence (Phase 1). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
        </dependency>

        <!-- Flyway runs over JDBC at boot; the Postgres adapter is required since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
        <!--
          (TAE phase 1, audit §21) — ArchUnit enforces the core/solana/trading package
          boundaries mechanically, so a future PR that reintroduces a forbidden dependency fails
          CI instead of relying on review.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers Postgres for the R2DBC stores the in-memory replica cannot prove
          (optimistic lock, unique operation_id, FOR UPDATE SKIP LOCKED): *IT classes under
          infrastructure/persistence/controlplane, run explicitly (-Dtest=…IT), never by plain
          `mvnw test` (Surefire's default include patterns do not match *IT). Needs Docker; the
          le-ci runner has it (contention between parallel Testcontainers jobs shows up as
          "bind: address already in use" — retry, it is not a code regression).
          the same Testcontainers Postgres backs the in-process chain E2E (ChainE2EIT,
          profile e2e-chain), which migrates and runs on its own throwaway instance.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Without this, spring-boot-dependencies' own dependencyManagement (3.4.2 pins testcontainers
          to 1.20.4) wins for the *transitive* `org.testcontainers:testcontainers` core artifact even
          though `postgresql`/`junit-jupiter` above are pinned to 1.21.4 — a mixed 1.20.4/1.21.4
          graph whose docker-java client mis-negotiates the daemon's API version ("client version
          1.32 is too old"; verified locally against Docker Engine 29.7.2, API 1.55). Pinning the
          core artifact explicitly keeps the whole Testcontainers graph on one version.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <!--
                      build-info writes META-INF/build-info.properties into target/classes at package time.
                      Spring auto-configures a BuildProperties bean from it, giving /actuator/info a service
                      version and an immutable build timestamp. No .git needed. NOTE: the existing
                      pom intentionally does not repackage (CryptoBot is not yet containerised — its
                      Dockerfile is tracked under an internal ticket); this execution does not change that.
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <!-- Runnable jar for the hackathon Docker image (docker-compose.hackathon.yml). -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Generates classpath:git.properties (commit id, commit time, branch). Spring auto-configures a
              GitProperties bean from it → /actuator/info git block and the commitSha of every log line.
              KAN-1215: this used to be git-commit-id-maven-plugin, but from a linked worktree
              (.worktrees/KAN-N-…) it resolves the main checkout's .git and stamps ITS commit/branch (measured:
              worktree at 09ea580 → git.properties 0b7624d/main), with JGit or native git, up to 10.0.1. Plain
              `git` run in the project dir resolves worktrees correctly. Never fails the build: without git or
              without .git (Docker build context) no file is written and BuildIdentityResolver uses the
              GIT_COMMIT/GIT_BRANCH/GIT_COMMIT_TIME build-args. Detached HEAD in CI → GITHUB_REF_NAME.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>git-properties</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if">
                                <property environment="env"/>
                                <available file="${project.basedir}/.git" property="gp.has.git"/>
                                <exec if:set="gp.has.git" executable="git" dir="${project.basedir}" outputproperty="gp.full"
                                      errorproperty="gp.err.full" failonerror="false" failifexecutionfails="false">
                                    <arg line="rev-parse HEAD"/>
                                </exec>
                                <exec if:set="gp.has.git" executable="git" dir="${project.basedir}" outputproperty="gp.abbrev"
                                      errorproperty="gp.err.abbrev" failonerror="false" failifexecutionfails="false">
                                    <arg line="rev-parse --short=7 HEAD"/>
                                </exec>
                                <exec if:set="gp.has.git" executable="git" dir="${project.basedir}" outputproperty="gp.time"
                                      errorproperty="gp.err.time" failonerror="false" failifexecutionfails="false">
                                    <env key="TZ" value="UTC"/>
                                    <arg line="show -s --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ HEAD"/>
                                </exec>
                                <exec if:set="gp.has.git" executable="git" dir="${project.basedir}" outputproperty="gp.ref"
                                      errorproperty="gp.err.ref" failonerror="false" failifexecutionfails="false">
                                    <arg line="rev-parse --abbrev-ref HEAD"/>
                                </exec>
                                <condition property="gp.branch" value="${env.GITHUB_REF_NAME}" else="${gp.ref}">
                                    <and>
                                        <equals arg1="${gp.ref}" arg2="HEAD"/>
                                        <isset property="env.GITHUB_REF_NAME"/>
                                    </and>
                                </condition>
                                <condition property="gp.ok">
                                    <matches string="${gp.full}" pattern="^[0-9a-f]{40}$"/>
                                </condition>
                                <echo if:set="gp.ok" file="${project.build.outputDirectory}/git.properties"
                                      encoding="UTF-8">git.branch=${gp.branch}
git.commit.id=${gp.full}
git.commit.id.abbrev=${gp.abbrev}
git.commit.time=${gp.time}
</echo>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          the real E2E against the demo stack (docker-compose.demo.yml) and a Solana RPC.
          Off by default: it needs Docker, a funded devnet wallet (or the local validator) and
          .env.demo. Surefire never picks *IT up; Failsafe does, only here:
            ./mvnw -Pe2e-devnet verify          (after scripts/demo/e2e-devnet.sh, or with the stack up)
        -->
        <profile>
            <id>e2e-devnet</id>
            <build>
                <plugins>
                    <!-- Only the E2E under this profile: the unit suite has its own `./mvnw verify`. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <includes>
                                <include>**/e2e/*IT.java</include>
                            </includes>
                            <trimStackTrace>false</trimStackTrace>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          the whole chain in one JVM-driven test, nothing stubbed inside the service:
          real Spring context on the real R2DBC stores (Postgres via Testcontainers, or CRYPTOBOT_IT_PG_*),
          cryptobot-validator and cryptobot-signer as real processes (their jars must be packaged first),
          Solana RPC and Runtime mocked at the HTTP level. Surefire never picks *IT up; Failsafe does, here:
            ./mvnw -f validator/pom.xml -DskipTests package && ./mvnw -f signer/pom.xml -DskipTests package
            ./mvnw -Pe2e-chain verify
        -->
        <profile>
            <id>e2e-chain</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <includes>
                                <include>**/e2e/chain/*IT.java</include>
                            </includes>
                            <trimStackTrace>false</trimStackTrace>
                            <!-- `verify` runs after spring-boot:repackage turned target/*.jar into a BOOT-INF fat jar
                                 that is not a classpath entry; the IT needs the plain classes. -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
