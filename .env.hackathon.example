# docker compose -f docker-compose.hackathon.yml --env-file .env.hackathon up -d --build
# Auth and Runtime are reached on the host (host.docker.internal). Nothing here is committed with real values.

# --- Life Engine (existing) ---
AUTH_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
JWT_SECRET=change-me-must-match-auth-and-runtime-32-chars-min
CRYPTOBOT_RUNTIME_BASE_URL=http://host.docker.internal:8090

# --- database (existing dev Postgres) ---
CRYPTOBOT_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/life_engine_cryptobot
CRYPTOBOT_R2DBC_URL=r2dbc:postgresql://host.docker.internal:5433/life_engine_cryptobot
CRYPTOBOT_DB_USER=life
CRYPTOBOT_DB_PASSWORD=change-me

# --- crypto control plane ---
CRYPTOBOT_REBALANCE_VAULT=<devnet pubkey that receives the executable leg>
CRYPTOBOT_SIGNER_TOKEN=<long random string, same as SIGNER_TOKEN>
CRYPTOBOT_ADVISOR_LOCALE=es
CRYPTOBOT_EXECUTION_ENABLED=true

# --- signer (host path to the 64-byte id.json; mounted read-only) ---
SIGNER_KEYPAIR_HOST_PATH=/home/you/.cryptobot-demo/demo-wallet.json
SIGNER_TOKEN=<same as CRYPTOBOT_SIGNER_TOKEN>
SIGNER_ALLOWED_DESTINATIONS=<same as CRYPTOBOT_REBALANCE_VAULT>
SIGNER_MAX_LAMPORTS=2000000000

# --- UI (what the browser calls) ---
UI_PORT=4204
UI_AUTH_BASE=http://localhost:8081
UI_CRYPTOBOT_BASE=http://localhost:8091
UI_DEMO_CLUSTER=devnet
